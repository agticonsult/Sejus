# Service Settings
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO

# Security & JWT Secrets
JWT_SECRET_KEY=conecta_egresso_jwt_secret_dev_2026
JWT_ALGORITHM=HS256
JWT_ISSUER=conecta-egresso-laravel
JWT_AUDIENCE=conecta-egresso-webrtc

# Redis Pub/Sub & Queue
REDIS_URL=redis://localhost:6379/0

# Webhook Dispatcher
LARAVEL_WEBHOOK_URL=http://localhost:8000/api/webhooks/webrtc
WEBHOOK_SECRET=conecta_egresso_webhook_secret_dev_2026
WEBHOOK_MAX_RETRIES=5
WEBHOOK_BASE_DELAY_SECONDS=1.0

# Coturn STUN/TURN (3G/4G/5G mobile traversal)
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=turn:localhost:3478
TURN_USERNAME=conecta_user
TURN_CREDENTIAL=conecta_password

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://localhost:3000
